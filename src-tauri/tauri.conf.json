{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "db-query",
  "version": "../package.json",
  "identifier": "com.dbquery.poc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run attribution",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "db-query",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "createUpdaterArtifacts": true,
    "resources": [
      "THIRD-PARTY-LICENSES.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5NTdENDJFMDA5RkIwN0UKUldSK3NKOEFMdFJYbVY3eFJCZUsxeFJrdzNybmMxaTZKNG1SM3lhOGZWY0lLckRvTVE5Y3BvMUoK",
      "endpoints": [
        "https://github.com/SparedRay/db-query/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
