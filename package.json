{
  "name": "db-query",
  "private": true,
  "version": "0.3.6",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:ui": "playwright test --project=chromium",
    "test:ui:webkit": "playwright test --project=webkit",
    "attribution": "node scripts/attribution.mjs",
    "version": "node scripts/set-version.mjs && cargo metadata --manifest-path src-tauri/Cargo.toml --offline --format-version 1 > /dev/null && git add src-tauri/Cargo.toml src-tauri/Cargo.lock",
    "postversion": "git --no-pager log -1 --oneline && echo \"Now: git push --follow-tags\""
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.9.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.11.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.43.11",
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.4.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
